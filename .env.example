# MAYA PICTURES — Environment Variables Configuration

# Application
NEXT_PUBLIC_APP_NAME="Maya Pictures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & JWT Secrets
JWT_SECRET="maya_pictures_super_secret_jwt_key_2026_change_in_production"
NEXTAUTH_SECRET="maya_pictures_nextauth_secret_token_2026"

# Database Connection (PostgreSQL for Production / Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Media Storage (Vercel Blob Storage — Automatically configured when linking Blob Store on Vercel)
# In production on Vercel, this is auto-injected by Vercel. For local dev, paste token from Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
STORAGE_PROVIDER="vercel-blob"

# Transactional Email Configuration
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
EMAIL_FROM="noreply@mayapictures.com"
NOTIFICATION_EMAIL="studio@mayapictures.com"
