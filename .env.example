# MAYA PICTURES — Environment Variables Configuration

# Application
NEXT_PUBLIC_APP_NAME="Maya Pictures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & JWT Secrets
JWT_SECRET="maya_pictures_super_secret_jwt_key_2026_change_in_production"
NEXTAUTH_SECRET="maya_pictures_nextauth_secret_token_2026"

# Database Connection (SQLite for local dev & quick testing, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Storage Settings (Local / Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"

# Transactional Email Configuration
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
EMAIL_FROM="noreply@mayapictures.com"
NOTIFICATION_EMAIL="studio@mayapictures.com"
